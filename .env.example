# Copie este arquivo para .env e preencha. O arquivo .env nunca vai para o repositório.
# Use UMA das duas formas de autenticar no Gemini.

# Forma 1: chave de API do Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Forma 2: login do gcloud (Application Default Credentials, para Vertex AI).
# Rode antes: gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=meu-projeto
# GOOGLE_CLOUD_LOCATION=global

# Opcional: troca o modelo que classifica as notícias.
# O padrão é gemini-3.5-flash-lite (o mais barato). gemini-3.8-flash é mais capaz.
# CLASSIFIER_MODEL=gemini-3.8-flash
